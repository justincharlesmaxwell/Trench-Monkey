# Copy this file to .env.local and fill in values.

# Set to "true" to route Claude calls through /api/generate (requires ANTHROPIC_API_KEY below).
# Leave "false" for direct-browser mode — users supply their own key in the app.
VITE_USE_PROXY=false

# Required when VITE_USE_PROXY=true.
# In Vercel: add this in Project → Settings → Environment Variables.
# Never commit a real key.
ANTHROPIC_API_KEY=sk-ant-...
